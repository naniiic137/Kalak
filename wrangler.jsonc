{
  // Cloudflare Workers config: `npx wrangler dev` runs it locally, `npx wrangler deploy` publishes it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalak",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // The workers.dev address is the game server for the Pages site, so keep it on.
  "workers_dev": true,
  // public/ is served as static files; the Worker only runs for /api/rooms and /ws.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // One Durable Object per room code holds that room's game in memory.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The free plan only allows SQLite-backed Durable Object classes (storage itself is not used).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
